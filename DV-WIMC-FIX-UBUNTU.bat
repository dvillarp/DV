@echo off
setlocal
echo === DV WIMC - FIX UBUNTU (soluciona error shared_preferences) ===
cd /d C:\dv\Claude

echo [1/5] Escribiendo lib\main.dart WIMC REAL...
if not exist lib mkdir lib
powershell -Command "$b64=''; [IO.File]::WriteAllBytes('lib\main.dart', [Convert]::FromBase64String($b64))"

echo [2/5] Escribiendo workflow UBUNTU (sin error de ruta larga)...
if not exist .github\workflows mkdir .github\workflows
powershell -Command "$b64=''; [IO.File]::WriteAllBytes('.github\workflows\build.yml', [Convert]::FromBase64String($b64))"

echo [3/5] Git add
git add .

echo [4/5] Commit
set /p MSG=Mensaje (ej: WIMC UBUNTU FIX): 
if "%MSG%"=="" set MSG=WIMC UBUNTU FIX
git commit -m "%MSG%"

echo [5/5] Push a GitHub y compilar APK en UBUNTU
git push origin main
if %errorlevel% neq 0 (
  git pull --rebase origin main
  git push origin main
  if %errorlevel% neq 0 (
    git push origin main --force
  )
)

echo.
echo Listo! Este build ya no falla en Windows.
echo Ve a https://github.com/dvillarp/DV/actions
pause
