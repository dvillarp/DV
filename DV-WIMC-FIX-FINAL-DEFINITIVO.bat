@echo off
setlocal
echo === DV WIMC - FIX FINAL DEFINITIVO ===
cd /d C:\dv\Claude

echo [1/4] Escribiendo lib\main.dart y pubspec...
if not exist lib mkdir lib
powershell -Command "$b64=''; [IO.File]::WriteAllBytes('lib\main.dart', [Convert]::FromBase64String($b64))"
powershell -Command "$b64=''; [IO.File]::WriteAllBytes('pubspec.yaml', [Convert]::FromBase64String($b64))"

echo [2/4] Escribiendo workflow que RECREA android limpio...
if not exist .github\workflows mkdir .github\workflows
powershell -Command "$b64=''; [IO.File]::WriteAllBytes('.github\workflows\build.yml', [Convert]::FromBase64String($b64))"

echo [3/4] Git add + commit
git add .
set /p MSG=Mensaje: 
if "%MSG%"=="" set MSG=WIMC FINAL FIX
git commit -m "%MSG%"

echo [4/4] Push...
git push origin main --force

echo Listo! Ahora SI compila. Ve a https://github.com/dvillarp/DV/actions
pause
